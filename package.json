{
  "name": "paysafe-x402",
  "version": "1.0.0",
  "description": "PaySafe — a payment security firewall for x402 micropayment traffic. Advisory scanning: PII/secret leaks, replay, overpayment, prompt-injection-triggered payments, counterparty reputation. Non-custodial.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "node --experimental-strip-types src/devserver.ts",
    "demo:replay": "node --experimental-strip-types examples/replay-demo.ts",
    "gen:wallet": "node --experimental-strip-types examples/gen-test-wallet.ts",
    "dryrun": "node --experimental-strip-types examples/paid-dryrun.ts",
    "test": "node --experimental-strip-types test/run-tests.ts",
    "mcp": "node dist/mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coinbase/x402": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "@x402/extensions": "^2.0.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@x402/fetch": "^2.0.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0"
  },
  "license": "MIT"
}
